{
  "name": "highlightsgrabber",
  "version": "1.1.0",
  "private": true,
  "description": "Development tools for the HighlightsGrabber Firefox extension. Nothing here ships in the extension.",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "npx --yes web-ext@10 lint",
    "build": "npx --yes web-ext@10 build --overwrite-dest",
    "icons": "node scripts/export-icons.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "linkedom": "^0.18.12"
  },
  "webExt": {
    "ignoreFiles": [
      "CLAUDE.md",
      "docs",
      "scripts",
      "tests",
      "package.json",
      "package-lock.json",
      "assets/brand/README.md",
      "assets/brand/logo*.svg",
      "assets/brand/icon-on-dark.svg"
    ]
  }
}
